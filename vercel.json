{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.churroscafeqa.com" }],
      "destination": "https://churroscafeqa.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/optimized/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
