<a class="skip" href="#main"><%- t('Skip to content') %></a>
<div class="announcement">
  <span><%- t('A little coffee. A little cinnamon. A lot to love.') %></span>
  <span class="concept-label"><%- t('A CAFÉ CONCEPT · QATAR') %></span>
</div>
<header class="header">
  <a href="<%= langPrefix %>/" class="logo" aria-label="CreovoCafe home">
    <svg viewBox="0 0 40 42" fill="none" aria-hidden="true">
      <path d="M8 17h22v10c0 6-5 10-11 10S8 33 8 27V17Z" stroke="currentColor" stroke-width="2"/>
      <path d="M30 19h3a5 5 0 0 1 0 10h-3M6 40h27M14 12c-5-5 5-5 0-10m9 10c-5-5 5-5 0-10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <span>Creovo<span class="logo-cafe">Cafe</span><small><%- t('COFFEE. CHURROS. CONNECTION.') %></small></span>
  </a>
  <nav id="nav" aria-label="<%= t('Main navigation') %>">
    <a href="<%= langPrefix %>/menu/"><%- t('The menu') %></a>
    <a href="<%= langPrefix %>/about/"><%- t('Our story') %></a>
    <a href="<%= langPrefix %>/locations/"><%- t('Find your café') %></a>
    <a href="<%= langPrefix %>/catering/"><%- t('Catering') %></a>
  </nav>
  <div class="header-actions">
    <% if (isArabic) { %>
      <a href="<%= currentPath.replace(/^\/ar/, '') || '/' %>" class="language" lang="en" aria-label="English">EN</a>
    <% } else { %>
      <a href="/ar<%= currentPath === '/' ? '/' : currentPath %>" class="language" lang="ar" aria-label="العربية">عربي</a>
    <% } %>
    <button class="nav-toggle" aria-label="<%= t('Open navigation') %>" aria-expanded="false" aria-controls="nav">☰</button>
  </div>
</header>
